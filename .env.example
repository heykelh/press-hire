# Chaîne de connexion Neon (Dashboard Neon > Connect > "Pooled connection")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# URL publique de l'app (liens des jeux, notifications)
PUBLIC_BASE_URL=https://press-hire.vercel.app

# Mot de passe du studio (/studio), 8 caractères minimum
STUDIO_PASSWORD=change-moi-vraiment

# Modèles de langue : Gemini d'abord (gratuit sur aistudio.google.com), Groq en secours (console.groq.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Notifications ntfy : un nom de sujet long et impossible à deviner
NTFY_TOPIC=press-hire-xxxxxxxx
# NTFY_SERVER=https://ntfy.sh
