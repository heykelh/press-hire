# Chaîne de connexion Neon (Dashboard Neon > Connect > "Pooled connection")
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# URL publique de l'app (liens des jeux, notifications)
PUBLIC_BASE_URL=https://press-hire.vercel.app

# Mot de passe du studio (/studio), 8 caractères minimum
STUDIO_PASSWORD=change-moi-vraiment

# Modèles de langue, essayés dans cet ordre ; un modèle en panne est sauté automatiquement.
# Mets-en au moins deux qui savent écrire un jeu (Gemini + Cloudflare ou Z.ai). Ordre modifiable : LLM_ORDER=gemini,cloudflare,zai,groq
# 1. Gemini (gratuit sans carte : aistudio.google.com/apikey) — deux modèles, chacun son propre quota
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest
# 2. Cloudflare Workers AI (gratuit sans carte : 10 000 neurons/jour, soit une dizaine de jeux)
#    dash.cloudflare.com → Account ID (page d'accueil du compte) ; My Profile → API Tokens → modèle « Workers AI »
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_MODEL=@cf/zai-org/glm-4.7-flash,@cf/openai/gpt-oss-120b
# 3. Z.ai (GLM-4.7-Flash gratuit en permanence, une requête à la fois : z.ai → API Keys)
ZAI_API_KEY=
# ZAI_MODEL=glm-4.7-flash
# 4. Qwen (Alibaba Cloud Model Studio, région Singapour : modelstudio.console.alibabacloud.com)
#    Quota gratuit d'environ 1M de jetons par modèle pendant 90 jours, puis facturation automatique :
#    règle une alerte de dépense à 0,01 $ dans la console. DASHSCOPE_API_KEY est aussi accepté.
QWEN_API_KEY=
# QWEN_MODEL=qwen-plus,qwen-flash
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# 5. Groq (gratuit sans carte : console.groq.com) — ultra rapide ; en gratuit, 8 à 12k jetons/min :
#    sert à l'analyse et à la relecture, l'écriture passe automatiquement au suivant.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b,llama-3.3-70b-versatile
# GROQ_TPM=250000   # seulement si tu passes au plan Developer (payant à l'usage)
# 6. OpenRouter (modèles « :free », 50 requêtes/jour) — facultatif, OPENROUTER_MODEL obligatoire
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# Facultatifs, si tu as déjà une clé : MISTRAL_API_KEY / MISTRAL_MODEL, NVIDIA_API_KEY / NVIDIA_MODEL

# Notifications ntfy : un nom de sujet long et impossible à deviner
NTFY_TOPIC=press-hire-xxxxxxxx
# NTFY_SERVER=https://ntfy.sh
