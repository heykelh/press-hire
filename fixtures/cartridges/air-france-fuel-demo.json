          { "id": "r_neg", "label": { "fr": "Vol 640 · −380 kg · A321", "en": "Flight 640 · −380 kg · A321" }, "correct": "reject", "why": { "fr": "Une consommation négative, c'est un bug de capteur.", "en": "Negative burn is a sensor bug." } },
          { "id": "r_ok2", "label": { "fr": "Vol 233 · 5 020 kg · A321", "en": "Flight 233 · 5,020 kg · A321" }, "correct": "accept", "why": { "fr": "Rien à signaler.", "en": "Nothing to report." } },
