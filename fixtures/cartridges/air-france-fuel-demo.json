          { "id": "r_null", "label": { "fr": "Vol 118 · NULL · A320", "en": "Flight 118 · NULL · A320" }, "correct": "reject", "why": { "fr": "Pas de mesure, pas d'analyse.", "en": "No measurement, no analysis." } },
          { "id": "r_ok4", "label": { "fr": "Vol 560 · 4 480 kg · A320", "en": "Flight 560 · 4,480 kg · A320" }, "correct": "accept", "why": { "fr": "Ligne fiable.", "en": "Reliable row." } }
