          { "id": "r_lbs", "label": { "fr": "Vol 451 · 9 900 lbs · A320", "en": "Flight 451 · 9,900 lbs · A320" }, "correct": "reject", "why": { "fr": "Livres au lieu de kilos : à convertir d'abord.", "en": "Pounds instead of kilos: convert first." } },
